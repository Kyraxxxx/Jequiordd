# Firebase Environment Configuration
# 
# Copy this file to .env and replace with your Firebase project values.
# This file is for documentation - the actual firebase config is embedded
# in the JavaScript bundle for Firebase JS SDK usage.
#
# Firebase Console -> Project Settings -> General -> SDK setup and configuration

# Firebase Project ID (required)
VITE_FIREBASE_PROJECT_ID="your-project-id"

# Firebase App ID (required)  
VITE_FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"

# Firebase Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

# Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"

# IMPORTANT: Never commit real credentials to version control.
# The Firebase JS SDK requires these values to be available at runtime.
# Real security is enforced by Firestore Security Rules and Authentication.